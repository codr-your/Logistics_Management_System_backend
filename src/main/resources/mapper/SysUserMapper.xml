<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.warehouse.backend_system.mapper.SysUserMapper">

    <select id="selectUserList" resultType="com.warehouse.backend_system.entity.SysUser">
        select id,username,password,real_name,status,create_time from sys_user
        <where>
            <!-- 这里加上and！！where标签会自动去掉多余and，不加会sql语法报错 -->
            <if test="username != null and username !=''">
                and username like concat('%',#{username},'%')
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
    </select>

    <select id="selectUserPage" resultType="com.warehouse.backend_system.entity.SysUser">
        select * from sys_user
        <where>
            <if test="username != null and username != ''">
                and username like concat('%',#{username},'%')
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
        limit #{offset},#{pageSize}
    </select>

    <select id="countUser" resultType="java.lang.Long">
        select count(*) from sys_user
        <where>
            <if test="username != null and username != ''">
                and username like concat('%',#{username},'%')
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
    </select>

    <select id="selectByUsername" resultType="com.warehouse.backend_system.entity.SysUser">
        select * from sys_user where username = #{username}
    </select>

    <select id="selectByUsernameAndPassword" resultType="com.warehouse.backend_system.entity.SysUser">
        select id,username,password,real_name,status,create_time
        from sys_user
        where username = #{username} and password = #{password}
    </select>

</mapper>